    "react-router-dom": "^7.18.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
